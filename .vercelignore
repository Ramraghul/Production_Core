# Never upload local secrets or settings. A .env here would also be loaded by
# the function and could switch the file store back on, on a read-only disk.
.env
.env.*
!.env.example

# Not needed to build or run the Vercel deployment.
data/
coverage/
.vercel/
*.log
# Generated by `npm run vercel-build` on Vercel itself.
public/api-docs/
