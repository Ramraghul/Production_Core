# ---------------------------------------------------------------------------
# Production Core - environment configuration
# Copy to .env for local development:  cp .env.example .env
# Every value below has a safe built-in default, so .env is optional.
# ---------------------------------------------------------------------------

# --- HTTP -------------------------------------------------------------------
# Single port serves: HMI (/), Node-RED editor (/red), REST API (/api/v1),
# Swagger UI (/api-docs). Free PaaS providers inject PORT automatically.
PORT=1880
HOST=0.0.0.0

# --- Identity ---------------------------------------------------------------
NODE_ENV=development
PC_SITE_ID=WIN
PC_LOG_LEVEL=info          # debug | info | warn | error | silent

# --- Security ---------------------------------------------------------------
# API key required for all write (POST/PATCH/DELETE) endpoints.
# Reads stay open so the public demo is browsable.
PC_API_KEY=production-core-demo-key
# Leave blank to keep the Node-RED editor open (demo mode).
# Set both to password-protect the flow editor.
PC_EDITOR_USER=
PC_EDITOR_PASSWORD=
# Set to true to serve the editor read-only (recommended for a public demo).
PC_EDITOR_READONLY=false
# Writes per minute per client IP. The demo key is public, so this is the brake
# on a script hammering the plant. 0 disables it.
PC_RATE_LIMIT_WRITES=120

# --- Serverless (Vercel) ----------------------------------------------------
# Detected automatically on Vercel (VERCEL=1): Node-RED, MQTT and the file store
# default off, and each API request advances the simulator. Force it with:
# PC_SERVERLESS=true
# A full deployment (Render, Fly, Docker) that /red and /factory redirect to:
# PC_FULL_RUNTIME_URL=https://production-core.onrender.com
# The live event stream ends and reconnects after this many seconds (default 50
# on serverless, 0 = never on a server):
# PC_SSE_MAX_SECONDS=50

# --- MQTT broker (embedded Aedes; no external broker needed) -----------------
PC_MQTT_ENABLED=true
PC_MQTT_PORT=1883
PC_MQTT_WS_ENABLED=true    # MQTT-over-WebSocket shares the HTTP port at /mqtt
PC_MQTT_HOST=127.0.0.1

# --- Persistence ------------------------------------------------------------
# memory = in-RAM only (ephemeral hosts, CI)
# file   = in-RAM + periodic JSON snapshot to PC_DATA_DIR (local development)
PC_STORE=file
PC_DATA_DIR=./data
PC_SNAPSHOT_INTERVAL_MS=15000

# --- Production simulator ---------------------------------------------------
PC_SIM_ENABLED=true
PC_SIM_SPEED=1            # 1 = real time. Higher compresses time, which inflates
                          # throughput and OEE against wall-clock KPI windows.
PC_SIM_AUTOSTART=true
PC_SIM_SEED=20260916       # deterministic PRNG seed - same demo data every boot
PC_SIM_FAULTS=true         # inject realistic breakdowns, defects and andon calls
PC_SIM_CATCH_UP_SECONDS=0      # serverless: replay up to this many seconds of missed
                          # ticks per request (default 30 there, 0 on a server)
PC_SIM_AUTO_RELEASE_MINUTES=15  # simulated supervisor restarts an operator stop and the
                          # crew signs maintenance off on plan; 0 = never (hands-on demos)

# --- Demo data --------------------------------------------------------------
PC_SEED_ON_BOOT=true       # regenerate mock history so ephemeral hosts look alive
PC_SEED_DAYS=3             # days of synthetic production history to backfill
